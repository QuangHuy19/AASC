<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minigame Trắc Nghiệm 15 Câu</title>
    <!-- Thư viện tạo mã QR -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <style>
        :root {
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --danger: #dc2626;
            --success: #16a34a;
            --bg: #f8fafc;
            --card: #ffffff;
            --text: #1e293b;
        }
        * { box-sizing: border-box; font-family: 'Segoe UI', system-ui, sans-serif; }
        body { background: var(--bg); color: var(--text); margin: 0; padding: 16px; display: flex; justify-content: center; }
        .container { width: 100%; max-width: 680px; background: var(--card); padding: 24px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
        
        /* Thanh điều hướng Admin / Game */
        .nav-tabs { display: flex; gap: 8px; margin-bottom: 20px; border-bottom: 2px solid #e2e8f0; padding-bottom: 12px; }
        .tab-btn { flex: 1; padding: 10px; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; background: #e2e8f0; color: #475569; transition: 0.2s; }
        .tab-btn.active { background: var(--primary); color: white; }

        h1, h2, h3 { margin-top: 0; color: #0f172a; }
        .hidden { display: none !important; }

        /* Giao diện Trò chơi */
        .status-bar { display: flex; justify-content: space-between; align-items: center; background: #f1f5f9; padding: 12px 16px; border-radius: 10px; margin-bottom: 16px; font-weight: 700; }
        .timer-badge { color: var(--danger); font-size: 1.15rem; background: #fee2e2; padding: 4px 12px; border-radius: 20px; }
        .progress-track { width: 100%; height: 8px; background: #e2e8f0; border-radius: 4px; overflow: hidden; margin-bottom: 20px; }
        .progress-fill { height: 100%; background: var(--primary); width: 100%; transition: width 1s linear; }
        
        .question-box { font-size: 1.2rem; font-weight: 600; margin-bottom: 20px; line-height: 1.5; }
        .options-list { display: flex; flex-direction: column; gap: 12px; }
        .option-btn { text-align: left; padding: 14px 18px; border: 2px solid #cbd5e1; border-radius: 10px; background: white; font-size: 1rem; cursor: pointer; transition: 0.15s; font-weight: 500; }
        .option-btn:hover { border-color: var(--primary); background: #eff6ff; }
        
        /* Giao diện Admin */
        .qr-panel { text-align: center; background: #f8fafc; border: 2px dashed #cbd5e1; padding: 20px; border-radius: 12px; margin-bottom: 24px; }
        #qrcode { display: flex; justify-content: center; margin: 16px 0; }
        .input-group { margin-bottom: 12px; text-align: left; }
        .input-group label { display: block; font-weight: 600; margin-bottom: 6px; font-size: 0.9rem; }
        .input-control { width: 100%; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.95rem; }
        
        .question-card-admin { border: 1px solid #e2e8f0; border-radius: 10px; padding: 16px; margin-bottom: 16px; background: #fafafa; }
        .question-card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        
        .btn { padding: 12px 20px; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 1rem; transition: 0.2s; }
        .btn-primary { background: var(--primary); color: white; }
        .btn-primary:hover { background: var(--primary-hover); }
        .btn-success { background: var(--success); color: white; }
        .btn-danger { background: var(--danger); color: white; padding: 6px 12px; font-size: 0.85rem; }
        .btn-block { width: 100%; margin-top: 12px; }

        .score-circle { width: 120px; height: 120px; border-radius: 50%; background: #eff6ff; border: 4px solid var(--primary); display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: 800; color: var(--primary); margin: 20px auto; }
        
        @media (max-width: 500px) { .grid-2 { grid-template-columns: 1fr; } }
    </style>
</head>
<body>

<div class="container">
    <!-- Thanh chuyển đổi cho Admin (Tự động ẩn khi người chơi quét QR có ?mode=play) -->
    <div id="adminNav" class="nav-tabs">
        <button class="tab-btn active" onclick="switchView('game')">Chơi thử Minigame</button>
        <button class="tab-btn" onclick="switchView('admin')">Quản trị Câu hỏi & Mã QR</button>
    </div>

    <!-- ==================== GIAO DIỆN NGƯỜI CHƠI ==================== -->
    <div id="gameView">
        <!-- Màn hình chờ bắt đầu -->
        <div id="startScreen" style="text-align: center;">
            <h1>Minigame Thử Thách</h1>
            <p style="color: #475569; line-height: 1.6;">
                • Tổng số câu hỏi: <strong id="totalQInfo">15</strong> câu (Tối đa 15 điểm)<br>
                • Thời gian suy nghĩ: <strong>45 giây / câu</strong><br>
                • <strong>Lưu ý:</strong> Sau khi chọn đáp án hoặc hết giờ, hệ thống tự động qua câu mới và <strong>không thể quay lại câu trước</strong>.
            </p>
            <button class="btn btn-primary btn-block" onclick="startQuiz()">Bắt đầu chơi ngay</button>
        </div>

        <!-- Màn hình làm bài -->
        <div id="quizScreen" class="hidden">
            <div class="status-bar">
                <span id="questionProgress">Câu 1 / 15</span>
                <span class="timer-badge">⏱ <span id="timeLeft">45</span>s</span>
            </div>
            <div class="progress-track">
                <div id="timerBar" class="progress-fill"></div>
            </div>
            <div id="questionText" class="question-box">Đang tải câu hỏi...</div>
            <div id="optionsContainer" class="options-list"></div>
        </div>

        <!-- Màn hình kết quả -->
        <div id="resultScreen" class="hidden" style="text-align: center;">
            <h2>Hoàn thành phần thi!</h2>
            <p>Điểm số của bạn là:</p>
            <div class="score-circle" id="finalScore">0/15</div>
            <p id="resultFeedback" style="font-weight: 600; color: #475569;"></p>
        </div>
    </div>

    <!-- ==================== GIAO DIỆN ADMIN ==================== -->
    <div id="adminView" class="hidden">
        <div class="qr-panel">
            <h3>Mã QR Tham Gia Minigame</h3>
            <p style="font-size: 0.9rem; color: #64748b;">Nhập đường link web sau khi bạn đưa file này lên mạng (GitHub Pages, Netlify, Vercel...) để tạo QR cho người chơi quét:</p>
            <div class="input-group">
                <input type="text" id="gameUrlInput" class="input-control" placeholder="Ví dụ: https://ten-web-cua-ban.netlify.app" oninput="updateQRCode()">
            </div>
            <div id="qrcode"></div>
            <small style="color: var(--primary); font-weight: 600;" id="qrLinkPreview"></small>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <h3>Danh sách câu hỏi (<span id="adminQCount">15</span>)</h3>
            <button class="btn btn-primary" onclick="addQuestion()" style="padding: 8px 14px; font-size: 0.9rem;">+ Thêm câu hỏi</button>
        </div>
        
        <div id="questionsAdminList"></div>

        <button class="btn btn-success btn-block" onclick="saveAdminQuestions()">💾 Lưu thay đổi (Trên trình duyệt này)</button>
        <button class="btn btn-primary btn-block" style="background: #475569; margin-top: 8px;" onclick="exportHardcodeData()">📋 Copy dữ liệu câu hỏi để dán cố định vào Code</button>
    </div>
</div>

<script>
    // =========================================================================
    // DANH SÁCH 15 CÂU HỎI MẶC ĐỊNH (ADMIN CÓ THỂ SỬA TRỰC TIẾP TẠI ĐÂY HOẶC TRÊN WEB)
    // correct: 0 là A, 1 là B, 2 là C, 3 là D
    // =========================================================================
const DEFAULT_QUESTIONS = [
    {
        "q": "1.\tLà một trong hai Công ty đặt nền móng cho việc hình thành và phát triển nghề nghiệp kiểm toán tại Việt Nam, Hãng Kiểm toán AASC được Bộ Tài chính thành lập vào năm nào?",
        "options": [
            "1990",
            "1991",
            "1992",
            "1993"
        ],
        "correct": 1
    },
    {
        "q": "2.\tĐịa chỉ trụ sở chính của AASC là ở đâu?",
        "options": [
            "Số 1, Lê Phụng Hiểu, Hoàn Kiếm, HN",
            "Số 2, Lê Phụng Hiểu, Hoàn Kiếm, HN",
            "Số 3, Lê Phụng Hiểu, Hoàn Kiếm, HN",
            "Số 4, Lê Phụng Hiểu, Hoàn Kiếm, HN"
        ],
        "correct": 0
    },
    {
        "q": "3.\tĐịa chỉ website của Hãng Kiểm toán AASC là gì?",
        "options": [
            "www.avv.com.vn",
            "www.acgconsulting.com.vn",
            "www.acg.com.vn",
            "www.aasc.com.vn"
        ],
        "correct": 3
    },
    {
        "q": "4.\tHãng Kiểm toán AASC hiện là thành viên của một trong những Mạng lưới kế toán và tư vấn toàn cầu hàng đầu thế giới, tổ chức này có tên là gì?",
        "options": [
            "HLB International",
            "Kreston Global",
            "Baker Tilly International",
            "PKF International"
        ],
        "correct": 0
    },
    {
        "q": "5.\tHãng Kiểm toán AASC là thành viên của HLB International vào năm nào?",
        "options": [
            "2011",
            "2012",
            "2013",
            "2014"
        ],
        "correct": 0
    },
    {
        "q": "6.\tĐược Bộ Tài chính thành lập năm 1991, và sau đó chuyển đổi mô hình hoạt động từ Doanh nghiệp Nhà nước thành Công ty TNHH hai thành viên trở lên với tên mới là Công ty TNHH Dịch vụ Tư vấn Tài chính Kế toán và Kiểm toán vào năm 2007, vậy tên hiện tại của Công ty TNHH Hãng Kiểm toán AASC được đổi từ năm nào?",
        "options": [
            "2011",
            "2012",
            "2013",
            "2014"
        ],
        "correct": 0
    },
    {
        "q": "7.\tHiện nay, Hãng Kiểm toán AASC có văn phòng tại 3 tỉnh thành, đó là những tỉnh thành nào?",
        "options": [
            "Hà Nội, Tp. HCM, Vũng Tàu",
            "Hà Nội, Tp. HCM, Quảng Ninh",
            "Hà Nội, Tp. HCM, Đà Nẵng",
            "Hà Nội, Tp. HCM, Thanh Hóa"
        ],
        "correct": 1
    },
    {
        "q": "8.\tHiện nay, số lượng cán bộ, kiểm toán viên, nhân viên của Hãng Kiểm toán AASC là khoảng bao nhiêu?",
        "options": [
            "~ 300 người",
            "~ 400 người",
            "~ 500 người",
            "~ 600 người"
        ],
        "correct": 2
    },
    {
        "q": "9.\tHiện nay, Hãng Kiểm toán AASC có khoảng bao nhiêu nhân viên chuyên nghiệp có Chứng chỉ Kiểm toán viên Việt Nam, Chứng chỉ ACCA, Chứng chỉ CPA Úc, Chứng chỉ CIA và Chứng chỉ CIMA?",
        "options": [
            "~ 50 người",
            "~ 100 người",
            "~ 150 người",
            "~ 200 người"
        ],
        "correct": 1
    },
    {
        "q": "10.\tHãng Kiểm toán AASC luôn chú trọng xây dựng hình ảnh dựa trên 5 yếu tố: Minh bạch – Độc lập – Am hiểu – Tin cậy – Bền vững. Trong 5 yếu tố này, yếu tố nào là giá trị cốt lõi?",
        "options": [
            "Minh bạch",
            "Độc lập",
            "Tin cậy",
            "Bền vững"
        ],
        "correct": 0
    },
    {
        "q": "11.\tChủ tịch HĐTV và Ban Tổng Giám đốc AASC là những chuyên gia đầu ngành, những người có nhiều năm kinh nghiệm trong lĩnh vực kiểm toán, tư vấn tài chính, thuế, thẩm định giá và xác định giá trị doanh nghiệp. Đồng thời họ cũng là những chuyên gia uy tín đặt nền móng cho sự phát triển ngành kiểm toán độc lập ở Việt Nam. Chủ tịch HĐTV của AASC hiện nay là ai?",
        "options": [
            "Ông Ngô Đức Đoàn",
            "Ông Nguyễn Thanh Tùng",
            "Ông Bùi Văn Thảo",
            "Ông Đỗ Mạnh Cường"
        ],
        "correct": 0
    },
    {
        "q": "12.\tHiện nay, Hãng Kiểm toán AASC cung cấp nhiều dịch vụ. Theo bạn, dịch vụ chủ lực của AASC là dịch vụ nào?",
        "options": [
            "Dịch vụ kiểm toán",
            "Dịch vụ tư vấn ",
            "Dịch vụ kế toán",
            "Dịch vụ thẩm định giá"
        ],
        "correct": 0
    },
    {
        "q": "13.\tHãng Kiểm toán AASC nhận hồ sơ tuyển dụng Thực tập sinh Kiểm toán báo cáo tài chính đối với các đối tượng là sinh viên đang trong quá trình thực tập vào tháng mấy hàng năm?",
        "options": [
            "Tháng 8",
            "Tháng 9",
            "Tháng 10",
            "Tháng 11"
        ],
        "correct": 1
    },
    {
        "q": "14.\tHãng Kiểm toán AASC nhận hồ sơ tuyển dụng Trợ lý kiểm toán Báo cáo tài chính và Kiểm toán viên dành cho các đối tượng là Sinh viên vừa mới tốt nghiệp, Nhân viên kiểm toán và/hoặc kiểm toán viên vào tháng mấy hàng năm?",
        "options": [
            "Tháng 3 và tháng 4",
            "Tháng 4 và tháng 5",
            "Tháng 5 và tháng 6",
            "Tháng 6 và tháng 7"
        ],
        "correct": 1
    },
    {
        "q": "15.\tHãng Kiểm toán AASC đón nhận Huân chương Lao động Hạng Nhất của Chủ tịch nước vào năm nào?",
        "options": [
            "Năm 2010",
            "Năm 2011",
            "Năm 2012",
            "Năm 2013"
        ],
        "correct": 1
    }
];

    const TIME_PER_QUESTION = 45; // 45 giây mỗi câu
    let questions = JSON.parse(localStorage.getItem('minigame_questions')) || DEFAULT_QUESTIONS;
    let currentIndex = 0;
    let score = 0;
    let timeLeft = TIME_PER_QUESTION;
    let timerInterval = null;
    let qrCodeInstance = null;

    // Khởi tạo khi mở trang
    window.onload = function() {
        const urlParams = new URLSearchParams(window.location.search);
        // Nếu người chơi quét QR (có ?mode=play), ẩn thanh công cụ Admin
        if (urlParams.get('mode') === 'play') {
            document.getElementById('adminNav').classList.add('hidden');
        }
        document.getElementById('totalQInfo').innerText = questions.length;
        
        // Khởi tạo URL mặc định cho mã QR
        const baseUrl = window.location.href.split('?')[0];
        document.getElementById('gameUrlInput').value = baseUrl;
        updateQRCode();
        renderAdminQuestions();
    };

    // Chuyển đổi qua lại giữa tab Chơi thử và Quản trị
    function switchView(view) {
        const tabs = document.querySelectorAll('.tab-btn');
        tabs[0].classList.toggle('active', view === 'game');
        tabs[1].classList.toggle('active', view === 'admin');

        document.getElementById('gameView').classList.toggle('hidden', view !== 'game');
        document.getElementById('adminView').classList.toggle('hidden', view !== 'admin');
        if (view === 'admin') {
            clearInterval(timerInterval);
            renderAdminQuestions();
        } else {
            resetGameView();
        }
    }

    // ==================== LOGIC TRÒ CHƠI ====================
    function resetGameView() {
        clearInterval(timerInterval);
        document.getElementById('startScreen').classList.remove('hidden');
        document.getElementById('quizScreen').classList.add('hidden');
        document.getElementById('resultScreen').classList.add('hidden');
        document.getElementById('totalQInfo').innerText = questions.length;
    }

    function startQuiz() {
        if (questions.length === 0) {
            alert("Chưa có câu hỏi nào! Vui lòng thêm câu hỏi trong phần Quản trị.");
            return;
        }
        currentIndex = 0;
        score = 0;
        document.getElementById('startScreen').classList.add('hidden');
        document.getElementById('resultScreen').classList.add('hidden');
        document.getElementById('quizScreen').classList.remove('hidden');
        showQuestion();
    }

    function showQuestion() {
        clearInterval(timerInterval);
        timeLeft = TIME_PER_QUESTION;
        updateTimerUI();

        const currentQ = questions[currentIndex];
        document.getElementById('questionProgress').innerText = `Câu ${currentIndex + 1} / ${questions.length}`;
        document.getElementById('questionText').innerText = currentQ.q;

        const optionsContainer = document.getElementById('optionsContainer');
        optionsContainer.innerHTML = '';

        const labels = ['A', 'B', 'C', 'D'];
        currentQ.options.forEach((optText, idx) => {
            const btn = document.createElement('button');
            btn.className = 'option-btn';
            btn.innerText = `${labels[idx]}. ${optText}`;
            btn.onclick = () => selectAnswer(idx);
            optionsContainer.appendChild(btn);
        });

        // Bắt đầu đếm ngược 45 giây
        timerInterval = setInterval(() => {
            timeLeft--;
            updateTimerUI();
            if (timeLeft <= 0) {
                clearInterval(timerInterval);
                nextQuestion(); // Hết giờ tự động qua câu tiếp theo, không cộng điểm
            }
        }, 1000);
    }

    function updateTimerUI() {
        document.getElementById('timeLeft').innerText = timeLeft;
        const percent = (timeLeft / TIME_PER_QUESTION) * 100;
        document.getElementById('timerBar').style.width = `${percent}%`;
    }

    function selectAnswer(selectedIndex) {
        clearInterval(timerInterval);
        // Mỗi câu đúng cộng 1 điểm
        if (selectedIndex === Number(questions[currentIndex].correct)) {
            score += 1;
        }
        // Chuyển thẳng sang câu tiếp theo, không cho quay lại
        nextQuestion();
    }

    function nextQuestion() {
        currentIndex++;
        if (currentIndex < questions.length) {
            showQuestion();
        } else {
            finishQuiz();
        }
    }

    function finishQuiz() {
        clearInterval(timerInterval);
        document.getElementById('quizScreen').classList.add('hidden');
        document.getElementById('resultScreen').classList.remove('hidden');
        document.getElementById('finalScore').innerText = `${score}/${questions.length}`;
        
        let msg = "Cảm ơn bạn đã tham gia chương trình!";
        if (score === questions.length) msg = "Xuất sắc! Bạn trả lời đúng tuyệt đối!";
        else if (score >= questions.length * 0.7) msg = "Rất tốt! Bạn nắm kiến thức rất chắc!";
        document.getElementById('resultFeedback').innerText = msg;
    }

    // ==================== LOGIC ADMIN & MÃ QR ====================
    function updateQRCode() {
        const rawUrl = document.getElementById('gameUrlInput').value.trim();
        const qrContainer = document.getElementById('qrcode');
        qrContainer.innerHTML = '';
        if (!rawUrl) return;

        // Tự động gắn ?mode=play để người quét chỉ thấy màn hình chơi
        const playUrl = rawUrl.includes('?') ? `${rawUrl}&mode=play` : `${rawUrl}?mode=play`;
        document.getElementById('qrLinkPreview').innerText = `Link khi quét: ${playUrl}`;

        qrCodeInstance = new QRCode(qrContainer, {
            text: playUrl,
            width: 180,
            height: 180,
            colorDark : "#0f172a",
            colorLight : "#ffffff",
            correctLevel : QRCode.CorrectLevel.M
        });
    }

    function renderAdminQuestions() {
        const container = document.getElementById('questionsAdminList');
        container.innerHTML = '';
        document.getElementById('adminQCount').innerText = questions.length;

        questions.forEach((item, index) => {
            const card = document.createElement('div');
            card.className = 'question-card-admin';
            card.innerHTML = `
                <div class="question-card-header">
                    <strong>Câu ${index + 1} (1 điểm)</strong>
                    <button class="btn btn-danger" onclick="removeQuestion(${index})">Xóa</button>
                </div>
                <div class="input-group">
                    <label>Nội dung câu hỏi:</label>
                    <input type="text" class="input-control q-text" value="${escapeHtml(item.q)}" oninput="syncQuestionData(${index}, 'q', this.value)">
                </div>
                <div class="grid-2">
                    <div class="input-group">
                        <label>Đáp án A:</label>
                        <input type="text" class="input-control" value="${escapeHtml(item.options[0])}" oninput="syncOptionData(${index}, 0, this.value)">
                    </div>
                    <div class="input-group">
                        <label>Đáp án B:</label>
                        <input type="text" class="input-control" value="${escapeHtml(item.options[1])}" oninput="syncOptionData(${index}, 1, this.value)">
                    </div>
                    <div class="input-group">
                        <label>Đáp án C:</label>
                        <input type="text" class="input-control" value="${escapeHtml(item.options[2])}" oninput="syncOptionData(${index}, 2, this.value)">
                    </div>
                    <div class="input-group">
                        <label>Đáp án D:</label>
                        <input type="text" class="input-control" value="${escapeHtml(item.options[3])}" oninput="syncOptionData(${index}, 3, this.value)">
                    </div>
                </div>
                <div class="input-group" style="margin-top: 8px; margin-bottom: 0;">
                    <label>Đáp án đúng:</label>
                    <select class="input-control" onchange="syncQuestionData(${index}, 'correct', Number(this.value))">
                        <option value="0" ${Number(item.correct) === 0 ? 'selected' : ''}>Đáp án A</option>
                        <option value="1" ${Number(item.correct) === 1 ? 'selected' : ''}>Đáp án B</option>
                        <option value="2" ${Number(item.correct) === 2 ? 'selected' : ''}>Đáp án C</option>
                        <option value="3" ${Number(item.correct) === 3 ? 'selected' : ''}>Đáp án D</option>
                    </select>
                </div>
            `;
            container.appendChild(card);
        });
    }

    function syncQuestionData(index, field, value) {
        questions[index][field] = value;
    }

    function syncOptionData(qIndex, optIndex, value) {
        questions[qIndex].options[optIndex] = value;
    }

    function addQuestion() {
        questions.push({
            q: `Câu hỏi số ${questions.length + 1}: Nhập câu hỏi...`,
            options: ["Đáp án A", "Đáp án B", "Đáp án C", "Đáp án D"],
            correct: 0
        });
        renderAdminQuestions();
    }

    function removeQuestion(index) {
        if (confirm(`Bạn có chắc muốn xóa Câu ${index + 1}?`)) {
            questions.splice(index, 1);
            renderAdminQuestions();
        }
    }

    function saveAdminQuestions() {
        localStorage.setItem('minigame_questions', JSON.stringify(questions));
        alert("Đã lưu danh sách câu hỏi thành công trên trình duyệt này!");
    }

    function exportHardcodeData() {
        const jsonString = `const DEFAULT_QUESTIONS = ${JSON.stringify(questions, null, 4)};`;
        navigator.clipboard.writeText(jsonString).then(() => {
            alert("Đã copy mã nguồn câu hỏi! Bạn hãy mở file index.html, tìm dòng 'const DEFAULT_QUESTIONS = [...]' và dán đè lên để mọi điện thoại quét QR đều nhận được bộ câu hỏi mới này.");
        });
    }

    function escapeHtml(str) {
        return String(str).replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }
</script>

</body>
</html>
